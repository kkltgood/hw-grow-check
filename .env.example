# 环境变量默认值清单，可作为配置模板。
# 本项目不会自动读取 .env：需要时复制为 .env 后 `set -a; source .env; set +a`，或由调度器注入。
# 所有项都有默认值，按需覆盖。

# 启用的任务：checkin（签到）/ harmony（浏览鸿蒙案例）/ devspace（体验 AI DevSpace）/ star（每日 Star 案例仓）/ star-weekly（每周 Star 实践中心仓）
GROW_TASKS=checkin,harmony,devspace,star,star-weekly

# 浏览器
GROW_HEADLESS=true
# 填 chrome 可复用系统 Chrome，省去下载 Playwright Chromium
GROW_CHANNEL=

# 路径
GROW_DATA_DIR=./data
# 登录态（Cookie）
GROW_AUTH_FILE=./data/auth.json
# 统一账号配置：mail / gitcode / huawei 三段
GROW_ACCOUNT_FILE=./data/account.json

# 单任务超时（毫秒）
GROW_TIMEOUT_MS=120000

# 结果邮件页脚写的执行时刻
GROW_RUN_AT=09:15

# Webhook 通知：generic / feishu / dingtalk / bark / wecom / serverchan
GROW_NOTIFY_URL=
GROW_NOTIFY_TYPE=generic

# 告警邮件里展示的补跑命令；留空则自动按仓库位置生成
GROW_DAILY_CMD=

# 设为 1 时，cli.mjs 内部不再发告警邮件（由 scripts/daily.sh 统一发结果邮件，避免重复）
GROW_QUIET_MAIL=

# GitCode 访问令牌：Star 案例仓任务用；也可以写进 data/account.json 的 gitcode 段
GROW_GITCODE_TOKEN=

# 可选：账号密码会话失效时自动重新登录（也可写进 data/account.json 的 huawei 段）
GROW_ACCOUNT=
GROW_PASSWORD=

# 调试：把结果邮件 HTML 落盘，不发送也能用浏览器打开看版式
GROW_MAIL_HTML_OUT=
